# ========================================
# Domain Controller - Git Ignore
# ========================================

# ---- 构建产物 ----
mcu/build/
soc/build/
*.o
*.elf
*.hex
*.bin
*.map

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 编译缓存 ----
*.d
__pycache__/
obj_flash/
obj_ram/

# ---- SDK（不参与编译，本地自行下载） ----
mcu/S32_SDK_S32K1xx_RTM_4.0.2/*
!mcu/S32_SDK_S32K1xx_RTM_4.0.2/.gitkeep

# ---- PDF 文件 ----
*.pdf

# ---- 个人简历 ----
docs/resume/

# ---- 日志文件（运行时生成） ----
tools/uart_logger/log/

# ---- 工具编译产物 ----
tools/uart_logger/uart_logger

# ---- Claude 配置 / 缓存 ----
.claude/

# ---- 其他 ----
.DS_Store
Thumbs.db
10_s32k144_Demo_CAN/
